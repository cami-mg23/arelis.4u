<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Para Ti - Aracely</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background-color: #0B0205; overflow: hidden; font-family: 'Georgia', serif; color: white; }
    canvas { display: block; background: #0B0205; }
  </style>
</head>
<body>

<canvas id="mainCanvas"></canvas>

<script>
  window.addEventListener("load", () => {
    const canvas = document.getElementById("mainCanvas");
    const ctx = canvas.getContext("2d");

    let width = window.innerWidth;
    let height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;

    let estado = "carta";
    let tiempoInicio = 0;
    let textoFrase = "me encantan tus ojos, y el resto de tu rostro. :)";
    let textoAcumulado = "";
    let charIndex = 0;
    let lastCharTime = 0;

    const palabra = "ARACELY";
    const numColumnas = Math.floor(width / 22);
    let columnas = [];

    for (let i = 0; i < numColumnas; i++) {
      columnas.push({
        x: i * 22 + 10,
        y: Math.random() * -500,
        velocidad: 1.5 + Math.random() * 2
      });
    }

    canvas.addEventListener("click", (e) => {
      const rect = canvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;

      const centerX = width / 2;
      const centerY = height / 2;

      if (estado === "carta") {
        if (clickX >= centerX - 110 && clickX <= centerX + 110 &&
            clickY >= centerY + 40 && clickY <= centerY + 85) {
          estado = "animacion";
          tiempoInicio = Date.now();
        }
      } else if (estado === "frase") {
        if (clickX >= centerX - 60 && clickX <= centerX + 60 &&
            clickY >= centerY + 120 && clickY <= centerY + 150) {
          reiniciar();
        }
      }
    });

    function reiniciar() {
      estado = "carta";
      textoAcumulado = "";
      charIndex = 0;
      columnas.forEach(col => {
        col.y = Math.random() * -500;
      });
    }

    // --- FUNCIONES DE DIBUJO ---

    // Función para dibujar una flor simple para el ramo
    function drawFlower(ctx, cx, cy, radius, color, centerColor) {
      ctx.save();
      ctx.fillStyle = color;
      // Pétalos superpuestos
      for (let i = 0; i < 6; i++) {
        ctx.beginPath();
        const angle = (i * Math.PI * 2) / 6;
        ctx.arc(cx + Math.cos(angle) * (radius * 0.7), cy + Math.sin(angle) * (radius * 0.7), radius * 0.5, 0, Math.PI * 2);
        ctx.fill();
      }
      // Centro dorado
      ctx.fillStyle = centerColor;
      ctx.beginPath();
      ctx.arc(cx, cy, radius * 0.3, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    // Función principal para dibujar el ramo (CORREGIDO)
    function drawBouquet(ctx, centerX, centerY, scale) {
      ctx.save();
      ctx.scale(scale, scale);
      ctx.translate(centerX / scale, centerY / scale);

      // Tallos verdes convergentes
      ctx.strokeStyle = "#3A7D34";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(-15, -40); ctx.lineTo(-10, 40);
      ctx.moveTo(0, -50); ctx.lineTo(0, 50);
      ctx.moveTo(15, -40); ctx.lineTo(10, 40);
      ctx.stroke();

      // Cinta y Lazo dorado
      ctx.fillStyle = "#FFD700";
      ctx.beginPath();
      ctx.ellipse(0, 45, 12, 6, 0, 0, Math.PI * 2);
      ctx.fill();
      // Lazo (triángulos suaves)
      ctx.beginPath();
      ctx.moveTo(10, 45); ctx.quadraticCurveTo(30, 30, 30, 60); ctx.closePath(); ctx.fill();
      ctx.beginPath();
      ctx.moveTo(-10, 45); ctx.quadraticCurveTo(-30, 30, -30, 60); ctx.closePath(); ctx.fill();

      // Hojas verdes
      ctx.fillStyle = "#2D5A27";
      for (let i = 0; i < 4; i++) {
        const hx = (i % 2 === 0 ? -1 : 1) * 20;
        const hy = -20 + Math.floor(i / 2) * 15;
        ctx.beginPath();
        ctx.ellipse(hx, hy, 10, 5, (i % 2 === 0 ? 0.6 : -0.6), 0, Math.PI * 2);
        ctx.fill();
      }

      // Flores rosas y rojas (Dibujadas sobre los tallos y hojas)
      const colors = ["#FF2A75", "#FF0055", "#FF2A75"];
      drawFlower(ctx, -20, -40, 15, colors[0], "#FFD700"); // Rosa lateral
      drawFlower(ctx, 20, -40, 15, colors[2], "#FFD700");  // Rosa lateral
      drawFlower(ctx, 0, -60, 18, colors[1], "#FFD700");   // Rosa central más grande

      ctx.restore();
    }

    function loop() {
      ctx.clearRect(0, 0, width, height);
      const centerX = width / 2;
      const centerY = height / 2;

      if (estado === "carta") {
        ctx.fillStyle = "#0B0205";
        ctx.fillRect(0, 0, width, height);

        ctx.fillStyle = "#1F030B";
        ctx.strokeStyle = "#FF4081";
        ctx.lineWidth = 2;
        ctx.fillRect(centerX - 180, centerY - 130, 360, 260);
        ctx.strokeRect(centerX - 180, centerY - 130, 360, 260);

        ctx.fillStyle = "#FFF2F5";
        ctx.font = "italic 22px Georgia";
        ctx.textAlign = "center";
        ctx.fillText("✨ Para ti... ✨", centerX, centerY - 60);

        ctx.fillStyle = "#FF80AB";
        ctx.font = "italic 13px Georgia";
        ctx.fillText("Un detalle especial preparado para Aracely", centerX, centerY - 10);

        ctx.fillStyle = "#3A0014";
        ctx.strokeStyle = "#FF2A75";
        ctx.fillRect(centerX - 110, centerY + 40, 220, 45);
        ctx.strokeRect(centerX - 110, centerY + 40, 220, 45);

        ctx.fillStyle = "#FFFFFF";
        ctx.font = "bold 11px Georgia";
        ctx.fillText("✨ Presiona aquí para entrar ✨", centerX, centerY + 67);

      } else if (estado === "animacion") {
        ctx.fillStyle = "black";
        ctx.fillRect(0, 0, width, height);

        let transcurrido = (Date.now() - tiempoInicio) / 1000;

        columnas.forEach(col => {
          col.y += col.velocidad;
          if (col.y > height + 200 && transcurrido < 6.5) {
            col.y = -200;
          }

          for (let j = 0; j < palabra.length; j++) {
            let charY = col.y + (j * 22);
            if (charY > 0 && charY < height) {
              ctx.fillStyle = j === 0 ? "#FFF2F5" : "#FF4081";
              ctx.font = "italic 14px Georgia";
              ctx.fillText(palabra[j], col.x, charY);
            }
          }
        });

        if (transcurrido > 9.0) {
          estado = "frase";
          lastCharTime = Date.now();
        }

      } else if (estado === "frase") {
        ctx.fillStyle = "black";
        ctx.fillRect(0, 0, width, height);

        // --- DIBUJAR EL RAMO AQUÍ --- (CORREGIDO)
        drawBouquet(ctx, centerX, centerY - 60, 1.2);

        if (charIndex < textoFrase.length && Date.now() - lastCharTime > 100) {
          textoAcumulado += textoFrase[charIndex];
          charIndex++;
          lastCharTime = Date.now();
        }

        ctx.fillStyle = "#FFF2F5";
        ctx.font = "italic 16px Georgia";
        ctx.textAlign = "center";
        ctx.fillText(textoAcumulado, centerX, centerY + 50);

        if (charIndex >= textoFrase.length) {
          ctx.fillStyle = "#22000B";
          ctx.strokeStyle = "#FF4081";
          ctx.fillRect(centerX - 60, centerY + 120, 120, 30);
          ctx.strokeRect(centerX - 60, centerY + 120, 120, 30);

          ctx.fillStyle = "#FF80AB";
          ctx.font = "italic 12px Georgia";
          ctx.fillText("↺ Repetir", centerX, centerY + 140);
        }
      }

      requestAnimationFrame(loop);
    }

    window.addEventListener("resize", () => {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    });

    loop();
  });
</script>

</body>
</html>
